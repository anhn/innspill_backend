# Copy to AI4EDU_BE/.env.systest — values here override .env for test runs (dotenv never overrides existing env vars).
# NEVER point MONGO_URI at Atlas/production: tests create, modify and delete data to prove access-control bugs.
SESSION_SECRET=systest-session-secret-at-least-32-chars-long
NODE_ENV=development
FACEBOOK_APP_ID=test-fb-id
FACEBOOK_APP_SECRET=test-fb-secret
GOOGLE_CLIENT_ID=test-google-id
GOOGLE_CLIENT_SECRET=test-google-secret
CLIENT_URL=http://localhost:8080
SERVER_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-mock-systest
OPENAI_BASE_URL=http://127.0.0.1:4010/v1
PORT=3000
