# Copy to .env and fill in values. Never commit .env.
NODE_ENV=development
PORT=3000
BASE_PATH=

MONGO_URI=mongodb://127.0.0.1:27017/ai4edu_database

SESSION_SECRET=replace-with-at-least-32-random-characters

# claude uses CLAUDE_API for every chat agent. openai keeps the OpenAI client.
LLM_PROVIDER=claude
CLAUDE_API=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Embeddings still use OpenAI. Claude has no embeddings API.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
FEEDBACK_MODEL=

CLIENT_URL=http://localhost:8080
SERVER_URL=http://localhost:3000
CORS_ORIGINS=
ALLOW_LOCALHOST_CORS=true

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

TRUST_PROXY=
# Hand-in link checks (GitHub). Leave GITHUB_TOKEN unset unless you need a higher API rate limit.
# With a token, only repositories owned by GITHUB_PRIVATE_OWNERS may be private.
# GITHUB_TOKEN=
# GITHUB_PRIVATE_OWNERS=

# Per-user limits (src/middleware/aiLimits.js). Defaults shown.
# AI_LIMIT_PER_MINUTE=15
# AI_LIMIT_PER_DAY=200
# AI_LIMIT_STAFF_PER_MINUTE=60
# AI_LIMIT_STAFF_PER_DAY=2000
# LINK_LIMIT_PER_MINUTE=30
# LINK_LIMIT_PER_DAY=600

# Activity log (src/models/ToolEvent.js). Delete events after this many days; unset keeps them.
# ACTIVITY_RETENTION_DAYS=
# ACTIVITY_LIMIT_PER_MINUTE=300
# ACTIVITY_LIMIT_PER_DAY=50000
